# 控制模式：mock 为默认的本地模拟模式；真实 MCP 模式由后端支持的配置值决定。
ROBOT_CONTROL_MODE=mock

# MCP 传输方式：stdio 或 streamable_http。
MCP_TRANSPORT=stdio

# stdio：MCP 服务启动命令、JSON 数组参数和工作目录。
# 下列三项默认留空；mock 模式不代表已经连接任何真实 MCP 服务。
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=[]
MCP_SERVER_CWD=

# streamable HTTP：真实服务地址默认留空，请按部署环境填写。
MCP_HTTP_URL=

# MCP 工具名称：必须与 MCP 服务实际注册的工具名称一致。
MCP_TOOL_MOVE=move_velocity
MCP_TOOL_STOP=stop_robot
MCP_TOOL_RESET=reset_pose
MCP_TOOL_STATE=get_robot_state
MCP_TOOL_GRIPPER=set_gripper
MCP_TOOL_CAPABILITIES=list_capabilities

# FastAPI 监听地址和端口。
HOST=127.0.0.1
PORT=8000

# stdio 真实配置示例（仅示例，取消注释前请替换为实际路径）：
# MCP_SERVER_COMMAND=python3
# MCP_SERVER_ARGS=["/absolute/path/to/your_mcp_server.py"]
# MCP_SERVER_CWD=/absolute/path/to/your_mcp_project

# streamable HTTP 真实配置示例（仅示例，不代表该服务已启动或已验证）：
# MCP_TRANSPORT=streamable_http
# MCP_HTTP_URL=http://127.0.0.1:9000/mcp
